{
  "manifest_version": 3,
  "name": "Bilibili Usage Tracker",
  "description": "Track daily Bilibili web usage and upload summaries to Cloudflare D1 through a Worker.",
  "version": "1.2.3",
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "https://api.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "Bilibili Usage"
  },
  "options_page": "src/options.html"
}
