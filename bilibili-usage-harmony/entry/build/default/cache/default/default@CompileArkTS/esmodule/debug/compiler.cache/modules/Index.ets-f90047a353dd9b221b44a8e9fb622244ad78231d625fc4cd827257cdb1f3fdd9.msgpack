//# sourceMappingURL=Index.js.mapÂ•Ùt␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.abilityAccessCtrl.d.tsÙi␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.router.d.tsÙ^/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entry/src/main/ets/common/SettingsStore.etsÙa/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entry/src/main/ets/services/UsageCollector.etsÙ[/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entry/src/main/ets/services/D1Client.etsÙU/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entry/src/main/ets/pages/Index.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ8/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entryÙ2/Users/peiqixin/work/b-zhan/bilibili-usage-harmony¥entry¥1.0.0Ô␀␀Ù8/Users/peiqixin/work/b-zhan/bilibili-usage-harmony/entryÃÃÚ`Ximport { abilityAccessCtrl, common, Permissions, PermissionRequestResult } from '@kit.AbilityKit';
import { promptAction, router } from '@kit.ArkUI';
import { SettingsStore, Settings } from '../common/SettingsStore';
import { UsageCollector, DayPayload } from '../services/UsageCollector';
import { D1Client, DayRow } from '../services/D1Client';

const PINK = '#FB7299';
const PINK_DEEP = '#E45378';
const PINK_SOFT = '#FFE6EE';
const PINK_FILL = 'rgba(251,114,153,0.30)';
const PINK_FILL2 = 'rgba(251,114,153,0.02)';
const INK = '#222222';
const INK_SOFT = '#6B6470';
const GRID = '#F0E8EE';

// --- é€šç”¨å·¥å…· ---
function niceCeilMs(ms: number): number {
  if (ms <= 0) return 60_000;
  const steps: number[] = [
    60_000, 5 * 60_000, 10 * 60_000, 15 * 60_000, 30 * 60_000,
    60 * 60_000, 2 * 60 * 60_000, 3 * 60 * 60_000, 4 * 60 * 60_000,
    6 * 60 * 60_000, 8 * 60 * 60_000, 12 * 60 * 60_000, 24 * 60 * 60_000
  ];
  for (const s of steps) if (ms <= s) return s;
  return Math.ceil(ms / 3600_000) * 3600_000;
}

function axisLabelMs(ms: number): string {
  if (ms <= 0) return '0';
  const s = Math.round(ms / 1000);
  if (s < 60) return s + 's';
  const m = Math.round(s / 60);
  if (m < 60) return m + 'm';
  const hh = Math.floor(m / 60);
  const rem = m % 60;
  if (rem === 0) return hh + 'h';
  return hh + 'h' + rem + 'm';
}

function fmtDur(ms: number): string {
  ms = Math.max(0, Math.round(ms));
  if (ms < 1000) return ms + ' æ¯«ç§’';
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  if (h > 0) return `${h}å°æ—¶${m}åˆ†${sec}ç§’`;
  if (m > 0) return `${m}åˆ†${sec}ç§’`;
  return sec + 'ç§’';
}

function shortLabel(date: string): string {
  const parts = date.split('-');
  if (parts.length !== 3) return date;
  return `${Number(parts[1])}/${Number(parts[2])}`;
}

@Entry
@Component
struct Index {
  @State todayLocal: string = '--';
  @State todayAll: string = '--';
  @State recentDays: DayPayload[] = [];
  @State cloudDays: DayRow[] = [];
  @State selectedDate: string = '';
  @State refreshing: boolean = false;
  @State message: string = '';
  @State permGranted: boolean = false;
  @State usageSupported: boolean = false;
  @State backfilling: boolean = false;
  @State backfillResult: string = '';

  async aboutToAppear(): Promise<void> {
    await this.refresh();
  }

  private async refresh(): Promise<void> {
    if (this.refreshing) return;
    this.refreshing = true;
    this.message = '';
    try {
      const ctx = getContext(this) as common.UIAbilityContext;
      this.usageSupported = UsageCollector.canReadDetailedAppUsage();
      if (this.usageSupported) {
        const ok = await this.ensurePermission(ctx);
        this.permGranted = ok;
        if (!ok) {
          this.message = 'è¯·åœ¨ç³»ç»Ÿè®¾ç½® â†’ éšç§ â†’ åº”ç”¨ä½¿ç”¨è®°å½• ä¸­æŽˆäºˆæœ¬åº”ç”¨æƒé™åŽå†å›žæ¥';
          return;
        }
      } else {
        this.permGranted = false;
        this.message = UsageCollector.unsupportedReason();
      }

      this.recentDays = await UsageCollector.collectRecent(7);
      const todayKey = UsageCollector.fmtDate(new Date());
      const today = this.recentDays.find(d => d.date === todayKey);
      this.todayLocal = fmtDur(today ? today.totalMs : 0);
      // å§‹ç»ˆé»˜è®¤é€‰ä¸­"ä»Šå¤©"
      this.selectedDate = todayKey;

      const s = await SettingsStore.get(ctx);
      if (s.accountId && s.databaseId && s.apiToken) {
        const client = new D1Client(s);
        const schemaResp = await client.ensureSchema();
        if (schemaResp.ok) {
          if (this.usageSupported && today && today.totalMs > 0) {
            const up = await client.uploadDay(today);
            if (!up.ok) this.message = 'ä¸Šä¼ å¤±è´¥ï¼š' + up.error;
          }
        } else {
          this.message = 'å»ºè¡¨å¤±è´¥ï¼š' + schemaResp.error;
        }
        this.cloudDays = await client.queryRecent(7);
        const todayCloud = this.cloudDays.filter(r => r.date === todayKey)
          .reduce((sum, r) => sum + r.totalMs, 0);
        this.todayAll = fmtDur(todayCloud);
      } else {
        this.todayAll = 'æœªé…ç½® D1';
      }
    } catch (e) {
      this.message = 'é”™è¯¯ï¼š' + String((e as Error).message || e);
    } finally {
      this.refreshing = false;
    }
  }

  private async ensurePermission(ctx: common.UIAbilityContext): Promise<boolean> {
    const am = abilityAccessCtrl.createAtManager();
    const perms: Permissions[] = [
      'ohos.permission.BUNDLE_ACTIVE_INFO',
      'ohos.permission.KEEP_BACKGROUND_RUNNING'
    ];
    try {
      const result: PermissionRequestResult = await am.requestPermissionsFromUser(ctx, perms);
      const code = result.authResults && result.authResults.length > 0 ? result.authResults[0] : -1;
      return code === 0;
    } catch (_e) {
      return false;
    }
  }

  /** æ‰‹åŠ¨è¡¥ä¼ æœ€è¿‘ N å¤©åŽ†å²æ•°æ®ï¼ˆå¯¹åº”å®‰å“ç«¯ DailyUploadReceiver.upload æ‰‹åŠ¨å…¥å£ï¼‰ */
  private async backfill(days: number): Promise<void> {
    if (this.backfilling) return;
    this.backfilling = true;
    this.backfillResult = 'è¡¥ä¼ ä¸­â€¦';
    try {
      const ctx = getContext(this) as common.UIAbilityContext;
      const s = await SettingsStore.get(ctx);
      if (!s.accountId || !s.databaseId || !s.apiToken) {
        this.backfillResult = 'D1 æœªé…ç½®ï¼Œè¯·å…ˆå¡«å†™è®¾ç½®';
        return;
      }
      const client = new D1Client(s);
      await client.ensureSchema();
      const payloads = await UsageCollector.collectRecentForUpload(days, false);
      let uploaded = 0;
      for (const day of payloads) {
        const r = await client.uploadDay(day);
        if (r.ok) uploaded++;
      }
      this.backfillResult = `è¡¥ä¼ å®Œæˆï¼šå·²ä¸Šä¼  ${uploaded} å¤©`;
      // åˆ·æ–°äº‘ç«¯åˆ—è¡¨
      this.cloudDays = await client.queryRecent(7);
    } catch (e) {
      this.backfillResult = 'è¡¥ä¼ å¤±è´¥ï¼š' + String((e as Error).message || e);
    } finally {
      this.backfilling = false;
    }
  }

  build() {
    Scroll() {
      Column() {
        // Hero
        Column() {
          Row() {
            Text('B').fontSize(18).fontWeight(700).fontColor(PINK)
              .width(34).height(34).backgroundColor('#FFFFFF').borderRadius(10)
              .textAlign(TextAlign.Center)
            Column() {
              Text('é¸¿è’™åŽŸç”Ÿ Â· ä»Šæ—¥').fontSize(11).fontColor('#FFD4DF')
              Text(this.todayLocal).fontSize(26).fontWeight(700).fontColor('#FFFFFF')
                .margin({ top: 2 })
              Row() {
                Text('å…¨è®¾å¤‡æ€»è®¡ Â· ä»Šæ—¥').fontSize(11).fontColor('#FFFFFF').opacity(0.85)
                Text(this.todayAll).fontSize(13).fontWeight(700).fontColor('#FFFFFF')
                  .margin({ left: 6 })
              }
              .padding({ left: 8, right: 8, top: 2, bottom: 2 })
              .backgroundColor('rgba(255,255,255,0.18)')
              .borderRadius(8)
              .margin({ top: 6 })
            }
            .alignItems(HorizontalAlign.Start)
            .margin({ left: 10 })
            .layoutWeight(1)

            Text('âš™').fontSize(20).fontColor('#FFFFFF')
              .padding(6)
              .onClick(() => router.pushUrl({ url: 'pages/Settings' }))
          }
          .width('100%')

          Row() {
            this.chip(this.usageSupported ? (this.permGranted ? 'æƒé™å·²æŽˆäºˆ' : 'æƒé™æœªæŽˆäºˆ') : 'ç³»ç»Ÿä¸å¼€æ”¾ç»Ÿè®¡',
              this.usageSupported ? (this.permGranted ? '#34C759' : '#FF3B30') : '#FF9500')
            this.chip(this.todayAll === 'æœªé…ç½® D1' ? 'D1 æœªé…ç½®' : 'D1 å·²è¿žæŽ¥',
              this.todayAll === 'æœªé…ç½® D1' ? '#FF9500' : '#34C759')
          }.margin({ top: 12 })
        }
        .width('100%')
        .padding(16)
        .backgroundColor(PINK)
        .alignItems(HorizontalAlign.Start)

        if (this.message) {
          Text(this.message).fontSize(12).fontColor('#E45378')
            .padding(10).width('100%')
            .backgroundColor(PINK_SOFT)
        }

        // æœ€è¿‘ 7 å¤© æŠ˜çº¿å›¾
        Column() {
          Row() {
            Text('æœ€è¿‘ 7 å¤©').fontSize(14).fontWeight(700).fontColor(INK).layoutWeight(1)
            Button(this.refreshing ? 'åˆ·æ–°ä¸­â€¦' : 'åˆ·æ–°')
              .fontSize(12).height(28).type(ButtonType.Capsule)
              .backgroundColor(this.refreshing ? '#CCC' : PINK)
              .onClick(() => this.refresh())
          }.width('100%').margin({ bottom: 8 })

          TrendChart({
            days: this.recentDays,
            selectedDate: this.selectedDate,
            onSelect: (date: string): void => { this.selectedDate = date; }
          })
            .width('100%').height(200)
        }
        .padding(16)
        .width('100%')
        .alignItems(HorizontalAlign.Start)

        // 24 å°æ—¶æŠ˜çº¿
        Column() {
          Text(this.selectedDateLabel())
            .fontSize(13).fontWeight(700).fontColor(INK).margin({ bottom: 4 })
          Text(this.selectedDateSub())
            .fontSize(11).fontColor(INK_SOFT).margin({ bottom: 8 })
          HourChart({ hours: this.selectedHourArr() })
            .width('100%').height(180)
        }
        .padding(16)
        .width('100%')
        .alignItems(HorizontalAlign.Start)

        // äº‘ç«¯è®¾å¤‡åˆ—è¡¨
        Column() {
          Text('äº‘ç«¯è®¾å¤‡ Â· ' + this.selectedDateLabel())
            .fontSize(13).fontWeight(700).fontColor(INK).margin({ bottom: 8 })
          if (this.cloudDevicesForSelected().length === 0) {
            Text('æš‚æ— äº‘ç«¯æ•°æ®').fontSize(12).fontColor(INK_SOFT)
          } else {
            ForEach(this.cloudDevicesForSelected(), (row: DayRow) => {
              Row() {
                Text(this.srcTag(row.source))
                  .fontSize(10).fontColor('#FFFFFF')
                  .padding({ left: 6, right: 6, top: 2, bottom: 2 })
                  .backgroundColor(this.srcColor(row.source))
                  .borderRadius(6)
                Text(row.deviceAlias || row.deviceId)
                  .fontSize(13).fontColor(INK).margin({ left: 6 }).layoutWeight(1)
                Text(fmtDur(row.totalMs))
                  .fontSize(13).fontColor(PINK_DEEP).fontWeight(600)
              }
              .width('100%')
              .padding({ top: 8, bottom: 8 })
            }, (row: DayRow) => row.deviceId + '|' + row.source + '|' + row.date)
          }
        }
        .padding(16)
        .width('100%')
        .alignItems(HorizontalAlign.Start)

        // åŽ†å²è¡¥ä¼ åŒºï¼ˆå¯¹åº”å®‰å“ DailyUploadReceiver æ‰‹åŠ¨å…¥å£ï¼‰
        Column() {
          Text('åŽ†å²æ•°æ®è¡¥ä¼ ').fontSize(13).fontWeight(700).fontColor(INK).margin({ bottom: 8 })
          Text('æ‰‹åŠ¨è¡¥ä¼ æœ€è¿‘ N å¤©çš„ä½¿ç”¨è®°å½•åˆ° D1ï¼ˆä»…ä¸Šä¼ æœ‰æ•°æ®çš„æ—¥æœŸï¼Œä¸ä¼šè¦†ç›–å…¶å®ƒè®¾å¤‡è®°å½•ï¼‰')
            .fontSize(11).fontColor(INK_SOFT).margin({ bottom: 10 })
          Row() {
            Button(this.backfilling ? 'è¡¥ä¼ ä¸­â€¦' : 'è¡¥ä¼  7 å¤©')
              .fontSize(12).height(32).type(ButtonType.Capsule)
              .backgroundColor(this.backfilling ? '#CCC' : PINK)
              .margin({ right: 8 })
              .onClick(() => this.backfill(7))
            Button(this.backfilling ? 'è¡¥ä¼ ä¸­â€¦' : 'è¡¥ä¼  30 å¤©')
              .fontSize(12).height(32).type(ButtonType.Capsule)
              .backgroundColor(this.backfilling ? '#CCC' : PINK_DEEP)
              .margin({ right: 8 })
              .onClick(() => this.backfill(30))
            Button(this.backfilling ? 'è¡¥ä¼ ä¸­â€¦' : 'è¡¥ä¼  180 å¤©')
              .fontSize(12).height(32).type(ButtonType.Capsule)
              .backgroundColor(this.backfilling ? '#CCC' : '#555')
              .onClick(() => this.backfill(180))
          }.width('100%')
          if (this.backfillResult) {
            Text(this.backfillResult)
              .fontSize(12).fontColor(this.backfillResult.indexOf('å¤±è´¥') >= 0 ? '#E45378' : '#34C759')
              .margin({ top: 8 })
          }
        }
        .padding(16)
        .width('100%')
        .alignItems(HorizontalAlign.Start)
        .backgroundColor('#FAFAFA')
      }
      .width('100%')
    }
    .width('100%').height('100%')
    .backgroundColor('#FFFFFF')
  }

  @Builder chip(text: string, color: string) {
    Text(text).fontSize(11).fontColor('#FFFFFF')
      .padding({ left: 8, right: 8, top: 3, bottom: 3 })
      .backgroundColor(color)
      .borderRadius(10)
      .margin({ right: 6 })
  }

  selectedHourArr(): number[] {
    if (!this.selectedDate || !this.recentDays.length) return new Array<number>(24).fill(0);
    const found = this.recentDays.find(d => d.date === this.selectedDate);
    return found ? found.byHour : new Array<number>(24).fill(0);
  }

  selectedDateLabel(): string {
    if (!this.selectedDate) return 'ä»Šæ—¥';
    const today = UsageCollector.fmtDate(new Date());
    if (this.selectedDate === today) return 'ä»Šæ—¥ Â· ' + this.selectedDate;
    return this.selectedDate;
  }

  selectedDateSub(): string {
    if (!this.usageSupported) {
      return 'æœ¬æœºï¼šå½“å‰ SDK ä¸æ”¯æŒè¯»å–å…¶å®ƒ App ä½¿ç”¨æ—¶é•¿';
    }
    const arr = this.selectedHourArr();
    let sum = 0; for (const v of arr) sum += v;
    return 'æœ¬æœºï¼š' + fmtDur(sum) + ' ï½œ 24 å°æ—¶åˆ†å¸ƒ';
  }

  cloudDevicesForSelected(): DayRow[] {
    if (!this.selectedDate) return [];
    return this.cloudDays.filter(r => r.date === this.selectedDate);
  }

  srcTag(s: string): string {
    const k = (s || '').toLowerCase();
    if (k === 'app' || k === 'android') return 'Android';
    if (k === 'web' || k === 'browser') return 'æµè§ˆå™¨';
    if (k === 'harmony') return 'é¸¿è’™';
    return k || 'æœªçŸ¥';
  }
  srcColor(s: string): string {
    const k = (s || '').toLowerCase();
    if (k === 'app' || k === 'android') return '#2F7BFF';
    if (k === 'web' || k === 'browser') return '#FB7299';
    if (k === 'harmony') return '#34C759';
    return '#999999';
  }
}

/* ===================== æŠ˜çº¿å›¾ç»„ä»¶ï¼ˆæœ€è¿‘ N å¤©ï¼‰ ===================== */
@Component
struct TrendChart {
  @Prop days: DayPayload[];
  @Prop selectedDate: string;
  onSelect: (date: string) => void = (): void => {};

  private settings: RenderingContextSettings = new RenderingContextSettings(true);
  private ctx: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.settings);
  private clickXs: number[] = [];

  build() {
    Canvas(this.ctx)
      .width('100%').height('100%')
      .backgroundColor('#FFFFFF')
      .onReady((): void => { this.draw(); })
      .onClick((event?: ClickEvent): void => { if (event) this.onCanvasClick(event); })
  }

  // è§¦å‘é‡ç»˜
  aboutToAppear(): void {}

  // å½“ selectedDate / days æ”¹å˜æ—¶ ArkUI ä¼šè‡ªåŠ¨è°ƒ onReady? å…¼å®¹å†™æ³•ï¼šåœ¨ build é‡Œé€šè¿‡ stack ä¹Ÿå¯
  // è¿™é‡Œé€šè¿‡ @Watch
  // æ³¨ï¼šArkTS ä¸æ”¯æŒ watch åŒæ—¶ç”¨ @Propï¼Œå¾—æ‰‹åŠ¨åœ¨çˆ¶ç»„ä»¶ setState æ—¶é‡å»º â€” æˆ‘ä»¬ç”¨ key è®©ç»„ä»¶åˆ·æ–°
  // ç®€åŒ–ï¼šç›´æŽ¥æ¯æ¬¡ build â†’ reset ctx + åœ¨ draw é‡Œè¯»å–æœ€æ–°æ•°æ®

  private onCanvasClick(event: ClickEvent): void {
    if (!this.days || this.days.length === 0 || this.clickXs.length === 0) return;
    const x = event.x;
    // æœ€è¿‘é‚»ï¼šæ‰¾ clickXs ä¸­è·ç¦» x æœ€è¿‘çš„é‚£ä¸ª
    let bestIdx = 0;
    let bestDist = Number.POSITIVE_INFINITY;
    for (let i = 0; i < this.clickXs.length; i++) {
      const d = Math.abs(this.clickXs[i] - x);
      if (d < bestDist) { bestDist = d; bestIdx = i; }
    }
    const sorted = this.sortedDays();
    if (bestIdx >= 0 && bestIdx < sorted.length) {
      this.onSelect(sorted[bestIdx].date);
      this.draw();
    }
  }

  private sortedDays(): DayPayload[] {
    return [...(this.days || [])].sort((a, b) => a.date < b.date ? -1 : 1);
  }

  private draw(): void {
    const ctx = this.ctx;
    const w = ctx.width;
    const h = ctx.height;
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, w, h);

    const sorted = this.sortedDays();
    if (sorted.length === 0) {
      ctx.fillStyle = INK_SOFT;
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('æš‚æ— æ•°æ®', w / 2, h / 2);
      return;
    }

    const padLeft = 44; const padRight = 12; const padTop = 24; const padBot = 26;
    const chartLeft = padLeft;
    const chartRight = w - padRight;
    const chartTop = padTop;
    const chartBot = h - padBot;
    const innerW = chartRight - chartLeft;
    const innerH = chartBot - chartTop;

    const rawMax = sorted.reduce<number>((m: number, d: DayPayload) => Math.max(m, d.totalMs || 0), 0);
    const niceMax = niceCeilMs(Math.max(60_000, rawMax));

    // Y è½´ 4 æ®µ + æ•°å€¼
    ctx.strokeStyle = GRID;
    ctx.lineWidth = 1;
    ctx.fillStyle = INK_SOFT;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (let i = 0; i <= 4; i++) {
      const y = chartTop + innerH * i / 4;
      ctx.beginPath();
      ctx.moveTo(chartLeft, y);
      ctx.lineTo(chartRight, y);
      ctx.stroke();
      const value = niceMax * (1 - i / 4);
      ctx.fillText(axisLabelMs(value), chartLeft - 4, y);
    }

    const n = sorted.length;
    const slot = innerW / n;
    const xs: number[] = [];
    const ys: number[] = [];
    for (let i = 0; i < n; i++) {
      const d = sorted[i];
      const cx = chartLeft + slot * (i + 0.5);
      const ratio = (d.totalMs || 0) / niceMax;
      let y = chartBot - innerH * ratio;
      if (!d.totalMs) y = chartBot;
      else y = Math.min(y, chartBot - 2);
      xs.push(cx); ys.push(y);
    }
    this.clickXs = xs;

    // é€‰ä¸­èƒŒæ™¯é«˜äº®
    const selIdx = sorted.findIndex(d => d.date === this.selectedDate);
    if (selIdx >= 0) {
      ctx.fillStyle = 'rgba(251,114,153,0.10)';
      ctx.fillRect(xs[selIdx] - slot / 2 + 2, chartTop - 4, slot - 4, innerH + 4);
    }

    // å¡«å……
    const grad = ctx.createLinearGradient(0, chartTop, 0, chartBot);
    grad.addColorStop(0, PINK_FILL);
    grad.addColorStop(1, PINK_FILL2);
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(xs[0], chartBot);
    ctx.lineTo(xs[0], ys[0]);
    for (let i = 1; i < n; i++) {
      const midX = (xs[i - 1] + xs[i]) / 2;
      ctx.bezierCurveTo(midX, ys[i - 1], midX, ys[i], xs[i], ys[i]);
    }
    ctx.lineTo(xs[n - 1], chartBot);
    ctx.closePath();
    ctx.fill();

    // æŠ˜çº¿
    ctx.strokeStyle = PINK;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(xs[0], ys[0]);
    for (let i = 1; i < n; i++) {
      const midX = (xs[i - 1] + xs[i]) / 2;
      ctx.bezierCurveTo(midX, ys[i - 1], midX, ys[i], xs[i], ys[i]);
    }
    ctx.stroke();

    // ç‚¹
    for (let i = 0; i < n; i++) {
      const isSel = i === selIdx;
      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.arc(xs[i], ys[i], isSel ? 5 : (sorted[i].totalMs > 0 ? 3.5 : 2), 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = isSel ? PINK_DEEP : (sorted[i].totalMs > 0 ? PINK : '#E9CCD7');
      ctx.beginPath();
      ctx.arc(xs[i], ys[i], isSel ? 3.5 : (sorted[i].totalMs > 0 ? 2.2 : 1.5), 0, Math.PI * 2);
      ctx.fill();
      if (isSel) {
        ctx.strokeStyle = PINK_DEEP;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(xs[i], ys[i], 6, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    // é€‰ä¸­ tooltip
    if (selIdx >= 0) {
      const d = sorted[selIdx];
      const text = `${shortLabel(d.date)} Â· ${fmtDur(d.totalMs)}`;
      ctx.font = '11px sans-serif';
      const tw = ctx.measureText(text).width + 16;
      const th = 20;
      let tx = xs[selIdx] - tw / 2;
      if (tx < chartLeft) tx = chartLeft;
      if (tx + tw > chartRight) tx = chartRight - tw;
      let ty = ys[selIdx] - th - 8;
      if (ty < 2) ty = 2;
      ctx.fillStyle = '#18181B';
      ctx.beginPath();
      ctx.moveTo(tx + 6, ty);
      ctx.lineTo(tx + tw - 6, ty);
      ctx.quadraticCurveTo(tx + tw, ty, tx + tw, ty + 6);
      ctx.lineTo(tx + tw, ty + th - 6);
      ctx.quadraticCurveTo(tx + tw, ty + th, tx + tw - 6, ty + th);
      ctx.lineTo(tx + 6, ty + th);
      ctx.quadraticCurveTo(tx, ty + th, tx, ty + th - 6);
      ctx.lineTo(tx, ty + 6);
      ctx.quadraticCurveTo(tx, ty, tx + 6, ty);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = '#FFFFFF';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, tx + tw / 2, ty + th / 2);
    }

    // X è½´æ ‡ç­¾
    ctx.fillStyle = INK_SOFT;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const step = Math.max(1, Math.ceil(n / 6));
    for (let i = 0; i < n; i += step) {
      ctx.fillText(shortLabel(sorted[i].date), xs[i], chartBot + 4);
    }
    if (n > 0 && (n - 1) % step !== 0) {
      ctx.fillText(shortLabel(sorted[n - 1].date), xs[n - 1], chartBot + 4);
    }
  }
}

/* ===================== æŠ˜çº¿å›¾ç»„ä»¶ï¼ˆ24 å°æ—¶ï¼‰ ===================== */
@Component
struct HourChart {
  @Prop hours: number[];
  private settings: RenderingContextSettings = new RenderingContextSettings(true);
  private ctx: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.settings);

  build() {
    Canvas(this.ctx)
      .width('100%').height('100%')
      .backgroundColor('#FFFFFF')
      .onReady((): void => { this.draw(); })
  }

  private draw(): void {
    const ctx = this.ctx;
    const w = ctx.width;
    const h = ctx.height;
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, w, h);

    const padLeft = 44; const padRight = 12; const padTop = 16; const padBot = 24;
    const chartLeft = padLeft;
    const chartRight = w - padRight;
    const chartTop = padTop;
    const chartBot = h - padBot;
    const innerW = chartRight - chartLeft;
    const innerH = chartBot - chartTop;

    const arr = this.hours || new Array<number>(24).fill(0);
    let rawMax = 0;
    for (const v of arr) if (v > rawMax) rawMax = v;
    if (rawMax <= 0) {
      ctx.fillStyle = INK_SOFT;
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('å°šæ— æ—¶æ®µæ•°æ®', w / 2, h / 2);
      return;
    }
    const niceMax = niceCeilMs(rawMax);

    // Y è½´
    ctx.strokeStyle = GRID;
    ctx.lineWidth = 1;
    ctx.fillStyle = INK_SOFT;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (let i = 0; i <= 4; i++) {
      const y = chartTop + innerH * i / 4;
      ctx.beginPath();
      ctx.moveTo(chartLeft, y);
      ctx.lineTo(chartRight, y);
      ctx.stroke();
      const value = niceMax * (1 - i / 4);
      ctx.fillText(axisLabelMs(value), chartLeft - 4, y);
    }

    // 24 ä¸ªç‚¹
    const n = 24;
    const stepX = innerW / (n - 1);
    const xs: number[] = [];
    const ys: number[] = [];
    for (let i = 0; i < n; i++) {
      const v = arr[i] || 0;
      const cx = chartLeft + stepX * i;
      let y = chartBot - (v / niceMax) * innerH;
      if (v <= 0) y = chartBot;
      else y = Math.min(y, chartBot - 2);
      xs.push(cx); ys.push(y);
    }

    // å¡«å……
    const grad = ctx.createLinearGradient(0, chartTop, 0, chartBot);
    grad.addColorStop(0, PINK_FILL);
    grad.addColorStop(1, PINK_FILL2);
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(xs[0], chartBot);
    ctx.lineTo(xs[0], ys[0]);
    for (let i = 1; i < n; i++) {
      const midX = (xs[i - 1] + xs[i]) / 2;
      ctx.bezierCurveTo(midX, ys[i - 1], midX, ys[i], xs[i], ys[i]);
    }
    ctx.lineTo(xs[n - 1], chartBot);
    ctx.closePath();
    ctx.fill();

    // æŠ˜çº¿
    ctx.strokeStyle = PINK;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(xs[0], ys[0]);
    for (let i = 1; i < n; i++) {
      const midX = (xs[i - 1] + xs[i]) / 2;
      ctx.bezierCurveTo(midX, ys[i - 1], midX, ys[i], xs[i], ys[i]);
    }
    ctx.stroke();

    // éžé›¶ç‚¹
    for (let i = 0; i < n; i++) {
      if ((arr[i] || 0) <= 0) continue;
      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.arc(xs[i], ys[i], 3, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = PINK;
      ctx.beginPath();
      ctx.arc(xs[i], ys[i], 1.9, 0, Math.PI * 2);
      ctx.fill();
    }

    // X è½´æ ‡ç­¾
    ctx.fillStyle = INK_SOFT;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const labels: number[] = [0, 6, 12, 18, 23];
    for (const i of labels) {
      ctx.fillText(`${i}:00`, xs[i], chartBot + 4);
    }
  }
}
