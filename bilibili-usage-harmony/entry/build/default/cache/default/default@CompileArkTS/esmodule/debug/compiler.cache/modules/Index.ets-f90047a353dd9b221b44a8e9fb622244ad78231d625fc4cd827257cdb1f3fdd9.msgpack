function niceCeilMs(ms) {
    if (ms <= 0)
        return 60000;
    const steps = [
        60000, 5 * 60000, 10 * 60000, 15 * 60000, 30 * 60000,
        60 * 60000, 2 * 60 * 60000, 3 * 60 * 60000, 4 * 60 * 60000,
        6 * 60 * 60000, 8 * 60 * 60000, 12 * 60 * 60000, 24 * 60 * 60000
    ];
    for (const s of steps)
        if (ms <= s)
            return s;
    return Math.ceil(ms / 3600000) * 3600000;
}
function axisLabelMs(ms) {
    if (ms <= 0)
        return '0';
    const s = Math.round(ms / 1000);
    if (s < 60)
        return s + 's';
    const m = Math.round(s / 60);
    if (m < 60)
        return m + 'm';
    const hh = Math.floor(m / 60);
    const rem = m % 60;
    if (rem === 0)
        return hh + 'h';
    return hh + 'h' + rem + 'm';
}
function fmtDur(ms) {
    ms = Math.max(0, Math.round(ms));
    if (ms < 1000)
        return ms + ' æ¯«ç§’';
    const s = Math.floor(ms / 1000);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    if (h > 0)
        return `${h}å°æ—¶${m}åˆ†${sec}ç§’`;
    if (m > 0)
        return `${m}åˆ†${sec}ç§’`;
    return sec + 'ç§’';
}
function shortLabel(date) {
    const parts = date.split('-');
    if (parts.length !== 3)
        return date;
    return `${Number(parts[1])}/${Number(parts[2])}`;
}
